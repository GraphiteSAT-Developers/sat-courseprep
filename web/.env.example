# Desmos API key for the student calculator.
# For local development you can use the demo key from the Desmos API docs.
# Production needs a paid key (Starter or above): the free key covers personal
# use or a 90-day internal evaluation only. See docs/desmos-integration.md.
NEXT_PUBLIC_DESMOS_API_KEY=

# Desmos API version. Pin it and change it on purpose; the Phase 0 audit should
# confirm which version matches the College Board build.
NEXT_PUBLIC_DESMOS_API_VERSION=v1.11

# ---------------------------------------------------------------------------
# AI tutor. Selection order (web/lib/tutor/provider.ts):
#   1. TUTOR_PROVIDER, if set, forces one of: endpoint | anthropic | stub
#   2. else TUTOR_ENDPOINT_URL + TUTOR_ENDPOINT_MODEL set -> "endpoint"
#   3. else ANTHROPIC_API_KEY set                         -> "anthropic"
#   4. else                                               -> "stub"
# With no model configured, a stub answers from each item's stored solution.
# Rollback from the fine-tuned tutor is TUTOR_PROVIDER=anthropic.
# ---------------------------------------------------------------------------
TUTOR_PROVIDER=

# "anthropic": Sonnet. Decision 2026-10-15: Sonnet is the solver, dialogue
# generator and judge, and serves live until the fine-tuned model passes the
# eval gate (docs/fine-tuning-plan.md).
ANTHROPIC_API_KEY=
# Pinned Anthropic tutor model. Change on purpose and re-run the evals first.
TUTOR_MODEL=claude-sonnet-5-5

# "endpoint": the fine-tuned open-weight tutor on any OpenAI-compatible
# chat-completions endpoint (Together, Fireworks, vLLM, Bedrock). 30 s timeout;
# any non-200 or empty reply becomes a neutral fallback line.
# Base URL (e.g. https://api.together.xyz/v1, http://localhost:8000/v1) or the
# full .../chat/completions URL.
TUTOR_ENDPOINT_URL=
# Bearer token. Leave empty for a local vLLM with no auth.
TUTOR_ENDPOINT_KEY=
# Interim live tutor (decision 2026-10-16): Qwen3.7-Plus on QwenCloud.
#   TUTOR_ENDPOINT_URL=https://maas.qwencloudapi.com/compatible-mode/v1
#   TUTOR_ENDPOINT_MODEL=<Qwen3.7-Plus API name, copied from the QwenCloud console>
# Use the base URL the console shows for your key's region and plan.
# Model name as the endpoint knows it, e.g. the fine-tuned model's ID. Pin it;
# a new fine-tune is a new ID and must pass the eval gate first.
TUTOR_ENDPOINT_MODEL=
