{
  "id": "discriminant",
  "order": 206,
  "domain": "advanced-math",
  "skill": "nonlinear-equations-in-one-variable-and-systems-of-equations-in-two-variables",
  "title": "How many real solutions?",
  "minutes": 5,
  "hook": "$b^{2} -$ 4ac decides it: positive means two, zero means one, negative means none.",
  "steps": [
    {
      "type": "slider",
      "prompt": "Drag $c$ until $y = x^{2} + 4x + c$ just touches the $x$-axis.",
      "param": {
        "name": "c",
        "min": -4,
        "max": 10,
        "step": 1,
        "start": -2
      },
      "answer": 4,
      "why": "It touches once when $b^{2} -$ 4ac $= 0$: $16 - 4c = 0$, so $c = 4$. Bigger $c$ lifts it off the axis (no real solutions).",
      "curves": [
        "x^2+4x+c"
      ],
      "window": {
        "x": [
          -6,
          2
        ],
        "y": [
          -6,
          10
        ]
      },
      "readout": "$y = x^2 + 4x + {c}$"
    },
    {
      "type": "recall",
      "prompt": "From memory: what does the discriminant $b^{2} -$ 4ac tell you?",
      "answer": "How many real solutions: positive means 2, zero means 1, negative means 0."
    },
    {
      "type": "fill",
      "prompt": "Find the discriminant of $x^{2} + 4x + 7$.",
      "lines": [
        "$b^{2} -$ 4ac $= 4^{2} - 4(1)(7)$",
        "$= 16 - 28$",
        "$=$ ___"
      ],
      "accept": [
        "-12"
      ],
      "why": "It's negative, so there are no real solutions."
    },
    {
      "type": "predict",
      "prompt": "How many real solutions does $x^{2} - 10x + 25 = 0$ have?",
      "choices": [
        "0",
        "1",
        "2"
      ],
      "answer": 1,
      "why": "$100 - 100 = 0$, so one solution: $x = 5$."
    },
    {
      "type": "predict",
      "prompt": "For what $k$ does $x^{2} + 6x + k = 0$ have exactly one real solution?",
      "choices": [
        "9",
        "6",
        "36",
        "3"
      ],
      "answer": 0,
      "why": "$36 - 4k = 0$, so $k = 9$."
    },
    {
      "type": "sort",
      "prompt": "Sort by how many times each parabola crosses the $x$-axis.",
      "buckets": [
        "Twice",
        "Once",
        "Never"
      ],
      "cards": [
        {
          "text": "$y = x^{2} - 9$",
          "bucket": 0
        },
        {
          "text": "$y = x^{2} + 2x + 1$",
          "bucket": 1
        },
        {
          "text": "$y = x^{2} + x + 5$",
          "bucket": 2
        },
        {
          "text": "$y = 2x^{2} - 3x - 2$",
          "bucket": 0
        },
        {
          "text": "$y = x^{2} - 6x + 9$",
          "bucket": 1
        }
      ],
      "why": "Positive discriminant: twice. Zero: once (it touches). Negative: never. $x^{2} + x + 5$ has $1 - 20 < 0$."
    },
    {
      "type": "predict",
      "prompt": "How many times does $y = 2x^{2} - 3x + 5$ cross the $x$-axis?",
      "choices": [
        "0",
        "1",
        "2"
      ],
      "answer": 0,
      "why": "$9 - 40 = -31$ is negative."
    },
    {
      "type": "spot",
      "prompt": "How many solutions does $3x^{2} + 2x - 1 = 0$ have? Tap the line with the mistake.",
      "lines": [
        "$b^{2} -$ 4ac $= 2^{2} - 4(3)(-1)$",
        "$= 4 - 12$",
        "$= -8$, so no real solutions"
      ],
      "wrong": 1,
      "why": "$-4(3)(-1) = +12$, so it's $4 + 12 = 16$: two real solutions."
    },
    {
      "type": "predict",
      "prompt": "The line $y = 2x + c$ meets the parabola $y = x^{2}$ at exactly one point when $c$ is:",
      "choices": [
        "$-1$",
        "1",
        "0",
        "2"
      ],
      "answer": 0,
      "why": "$x^{2} - 2x - c = 0$ has discriminant $4 + 4c$, which is 0 when $c = -1$."
    }
  ],
  "keys": [
    "$b^{2} -$ 4ac $> 0$: two real solutions.",
    "$b^{2} -$ 4ac $= 0$: one (the graph touches the $x$-axis).",
    "$b^{2} -$ 4ac $< 0$: none."
  ],
  "recall": [
    {
      "type": "predict",
      "prompt": "$b^{2} -$ 4ac $= 0$ means:",
      "choices": [
        "One real solution",
        "Two",
        "None"
      ],
      "answer": 0,
      "why": "A double root."
    },
    {
      "type": "predict",
      "prompt": "How many real solutions does $x^{2} + 2x + 5 = 0$ have?",
      "choices": [
        "0",
        "1",
        "2"
      ],
      "answer": 0,
      "why": "$4 - 20$ is negative."
    },
    {
      "type": "fill",
      "prompt": "$x^{2} + bx + 16 = 0$ has one solution and $b > 0$. Find $b$.",
      "lines": [
        "$b^{2} - 4(1)(16) = 0$",
        "$b^{2} = 64$",
        "$b =$ ___"
      ],
      "accept": [
        "8"
      ],
      "why": "$\\sqrt{64} = 8$."
    }
  ],
  "format": "lab",
  "tex": true
}
