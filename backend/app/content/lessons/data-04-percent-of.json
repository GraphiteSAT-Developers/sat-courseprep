      "right": [
        "× 1.25",
        "× 0.75",
        "× 0.35",
        "× 1.05",
        "× 0.95"
      ],
      "why": "Up p%: multiply by 1 + p/100. Down p%: by 1 − p/100. p% of: by p/100."
    },
    {
      "type": "spot",
      "prompt": "18 is what percent of 72? Tap the line with the mistake.",
      "lines": [
