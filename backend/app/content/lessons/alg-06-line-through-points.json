{
  "id": "line-through-two-points",
  "order": 107,
  "domain": "algebra",
  "skill": "linear-equations-in-two-variables",
  "title": "Write a line from two points",
  "minutes": 6,
  "hook": "Slope from two points, then plug one in for $b$. Plus parallel and perpendicular slopes.",
  "steps": [
    {
      "type": "recall",
      "prompt": "From memory: the slope through $(x_{1}, y_{1})$ and $(x_{2}, y_{2})$?",
      "answer": "$m = (y_{2} - y_{1}) / (x_{2} - x_{1})$: rise over run."
    },
    {
      "type": "fill",
      "prompt": "Find the slope through $(1, 4)$ and $(3, 10)$.",
      "lines": [
        "$m = (10 - 4) / (3 - 1)$",
        "$m =$ ___"
      ],
      "accept": [
        "3"
      ],
      "why": "$6 \\div 2 = 3$.",
      "lane": "hand"
    },
    {
      "type": "graph",
      "prompt": "Now the Desmos way. The points $(1, 4)$ and $(3, 10)$ are plotted. Type the line through both.",
      "accept": [
        "3x+1"
      ],
      "why": "$y = 3x + 1$ passes through both points. In Desmos you'd see it hit both dots right away.",
      "window": {
        "x": [
          -2,
          5
        ],
        "y": [
          -4,
          14
        ]
      },
      "points": [
        [
          1,
          4
        ],
        [
          3,
          10
        ]
      ],
      "lane": "desmos"
    },
    {
      "type": "fill",
      "prompt": "The line $y = 3x + b$ goes through $(1, 4)$. Find $b$.",
      "lines": [
        "$4 = 3(1) + b$",
        "$b =$ ___"
      ],
      "accept": [
        "1"
      ],
      "why": "So $y = 3x + 1$. Check $(3, 10)$: $9 + 1 = 10$.",
      "lane": "hand"
    },
    {
      "type": "predict",
      "prompt": "A line is parallel to $y = -2x + 5$. Its slope is:",
      "choices": [
        "$-2$",
        "2",
        "$1/2$",
        "$-1/2$"
      ],
      "answer": 0,
      "why": "Parallel lines have equal slopes."
    },
    {
      "type": "predict",
      "prompt": "A line is perpendicular to $y = (2/3)x - 1$. Its slope is:",
      "choices": [
        "$2/3$",
        "$-2/3$",
        "$3/2$",
        "$-3/2$"
      ],
      "answer": 3,
      "why": "Perpendicular slopes are negative reciprocals: flip it and change the sign."
    },
    {
      "type": "spot",
      "prompt": "Finding the slope through $(-2, 5)$ and $(4, 2)$. Tap the line with the mistake.",
      "lines": [
        "$m = (2 - 5) / (4 - (-2))$",
        "$m = -3 / 2$",
        "The slope is $-3/2$"
      ],
      "wrong": 1,
      "why": "$4 - (-2) = 4 + 2 = 6$, so $m = -3/6 = -1/2$."
    },
    {
      "type": "order",
      "prompt": "Write the line through $(2, 1)$ perpendicular to $y = 2x + 7$. Put the steps in order.",
      "items": [
        "The given slope is 2",
        "So the perpendicular slope is $-1/2$",
        "Plug in $(2, 1)$: $1 = -(1/2)(2) + b$",
        "$b = 2$, so $y = -(1/2)x + 2$"
      ],
      "why": "Slope first, then $b$ from the point."
    }
  ],
  "keys": [
    "$\\text{Slope} = (y_{2} - y_{1}) / (x_{2} - x_{1})$. Watch double negatives.",
    "Plug one point into $y = mx + b$ to find $b$.",
    "Parallel: same slope. Perpendicular: negative reciprocal."
  ],
  "recall": [
    {
      "type": "fill",
      "prompt": "Slope through $(0, 2)$ and $(4, 10)$.",
      "lines": [
        "$m = (10 - 2) / (4 - 0)$",
        "$m =$ ___"
      ],
      "accept": [
        "2"
      ],
      "why": "$8 \\div 4 = 2$."
    },
    {
      "type": "predict",
      "prompt": "Perpendicular to a line with slope 4:",
      "choices": [
        "$-1/4$",
        "$1/4$",
        "$-4$"
      ],
      "answer": 0,
      "why": "Flip and change the sign."
    },
    {
      "type": "predict",
      "prompt": "Parallel to $3x + y = 7$:",
      "choices": [
        "$-3$",
        "3",
        "$1/3$"
      ],
      "answer": 0,
      "why": "$y = -3x + 7$, so the slope is $-3$."
    }
  ],
  "format": "race",
  "tex": true
}
