      "answer": [
        4,
        0
      ],
      "why": "Solutions are where the graph crosses the $x$-axis: $(x - 4)(x + 2) = 0$, so $x = 4$ or $x = -2$.",
      "window": {
        "x": [
          -4,
          6
        ],
        "y": [
          -10,
          8
        ]
      },
      "snap": 1
    },
    {
      "type": "predict",
      "prompt": "Solve $2x^{2} + 3x - 2 = 0$.",
