        "$x = 2$ or $x = -2$",
        "$x = 1$ or $x = -2$"
      ],
      "answer": 0,
      "why": "It factors as $(2x - 1)(x + 2) = 0$."
    },
    {
      "type": "predict",
      "prompt": "What is the sum of the solutions of $x^{2} - 8x + 12 = 0$?",
