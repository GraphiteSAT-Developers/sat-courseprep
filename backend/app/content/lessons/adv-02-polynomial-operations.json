  "skill": "equivalent-expressions",
  "title": "Expand, combine and match coefficients",
  "minutes": 6,
  "hook": "Multiply every term by every term, combine like terms, and match coefficients to find unknowns.",
  "steps": [
    {
      "type": "recall",
      "prompt": "From memory: how many terms do you get when you multiply (x + 3)(x − 5), before combining?",
      "answer": "Four: x², −5x, 3x and −15. Combining the middle two gives x² − 2x − 15."
    },
    {
      "type": "fill",
      "prompt": "Expand (x + 3)(x − 5).",
      "lines": [
        "x² − 5x + 3x − 15",
        "x² + (___)x − 15"
      ],
      "accept": [
        "-2"
      ],
      "why": "−5x + 3x = −2x."
    },
    {
      "type": "grid",
      "prompt": "Sam's box for (2x + 3)(x − 4). Fill in the two empty boxes.",
      "head": [
        "×",
        "x",
        "−4"
      ],
      "rows": [
        [
          "2x",
          "2x²",
          "___"
        ],
        [
          "+3",
          "___",
          "−12"
        ]
      ],
      "accept": [
        [
          "-8x"
        ],
        [
          "3x"
        ]
      ],
      "why": "2x · (−4) = −8x and 3 · x = 3x. Add the middle terms: 2x² − 5x − 12."
    },
    {
      "type": "predict",
      "prompt": "Simplify (3x² − 2x + 5) − (x² + 4x − 1).",
      "choices": [
        "2x² − 6x + 6",
        "2x² + 2x + 4",
        "2x² − 6x + 4",
        "4x² + 2x + 4"
      ],
      "answer": 0,
      "why": "Distribute the minus to every term: 3x² − x² = 2x², −2x − 4x = −6x, and 5 + 1 = 6."
    },
    {
      "type": "spot",
      "prompt": "Expanding (2x − 3)². Tap the line with the mistake.",
      "lines": [
        "Start: (2x − 3)²",
        "= (2x)² − 3²",
        "= 4x² − 9"
      ],
      "wrong": 1,
      "why": "Squaring a difference isn't squaring each part. (2x − 3)² = 4x² − 12x + 9."
    },
    {
      "type": "predict",
      "prompt": "(ax + 2)(x − 3) = 4x² − 10x − 6. What is a?",
      "choices": [
        "4",
        "2",
        "−3",
        "−10"
      ],
      "answer": 0,
      "why": "Match the x² terms: a = 4. Check the middle: −12x + 2x = −10x."
    },
    {
      "type": "predict",
      "prompt": "Which is equivalent to x(x + 4) − 2(x + 4)?",
      "choices": [
        "(x − 2)(x + 4)",
        "(x + 2)(x + 4)",
        "x² + 2x + 8",
        "(x − 2)(x − 4)"
      ],
      "answer": 0,
      "why": "Both terms share (x + 4), so factor it out."
    },
    {
      "type": "fill",
      "prompt": "(x + k)² = x² + 10x + 25. Find k.",
      "lines": [
        "(x + k)² = x² + 2kx + k²",
        "2k = 10",
        "k = ___"
      ],
      "accept": [
        "5"
      ],
      "why": "And k² = 25 agrees."
    }
  ],
  "keys": [
    "Multiply every term by every term, then combine like terms.",
    "(a − b)² = a² − 2ab + b², never a² − b².",
    "To find unknown constants, match the coefficients of each power of x."
  ],
  "recall": [
    {
