{
  "id": "rational-exponents-radicals",
  "order": 204,
  "domain": "advanced-math",
  "skill": "equivalent-expressions",
  "title": "Radicals and fractional exponents",
  "minutes": 6,
  "hook": "x^(m/n) is the nth root of x, to the m. Switch between the forms freely.",
  "steps": [
    {
      "type": "recall",
      "prompt": "From memory: what does x^(1/2) mean?",
      "answer": "The square root of x: √x."
    },
    {
      "type": "predict",
      "prompt": "8^(2/3) =",
      "choices": [
        "4",
        "16/3",
        "2",
        "64"
      ],
      "answer": 0,
      "why": "The cube root of 8 is 2, and 2² = 4."
    },
    {
      "type": "predict",
      "prompt": "Which equals √(x³)?",
      "choices": [
        "x^(3/2)",
        "x^(2/3)",
        "x^6",
        "3x/2"
      ],
      "answer": 0,
      "why": "A square root is the 1/2 power: (x³)^(1/2) = x^(3/2)."
    },
    {
      "type": "match",
      "prompt": "Match each radical to the same thing written as an exponent.",
      "left": [
        "√x",
        "∛x",
        "√(x³)",
        "1/√x",
        "∛(x²)"
      ],
      "right": [
        "x^(1/2)",
        "x^(1/3)",
        "x^(3/2)",
        "x^(−1/2)",
        "x^(2/3)"
      ],
      "why": "The root goes in the denominator and the power in the numerator. Dividing by it makes the exponent negative."
    },
    {
      "type": "fill",
      "prompt": "Simplify √50.",
      "lines": [
        "√50 = √(25 × 2)",
        "= ___√2"
      ],
      "accept": [
        "5"
      ],
      "why": "√25 = 5."
    },
    {
      "type": "spot",
      "prompt": "Simplifying (x^(1/2))⁴ · x. Tap the line with the mistake.",
      "lines": [
        "(x^(1/2))⁴ = x^(1/2 + 4)",
        "= x^(9/2)",
        "Times x: x^(11/2)"
      ],
      "wrong": 0,
      "why": "A power of a power multiplies: (x^(1/2))⁴ = x². So the answer is x³."
    },
    {
      "type": "predict",
      "prompt": "Simplify (x² − 9) / (x − 3), for x ≠ 3.",
      "choices": [
        "x + 3",
        "x − 3",
        "x² − 3",
        "1/(x + 3)"
      ],
      "answer": 0,
      "why": "x² − 9 = (x − 3)(x + 3), and the (x − 3) cancels."
    },
    {
      "type": "predict",
      "prompt": "Which is equivalent to 1 / x^(−2)?",
      "choices": [
        "x²",
        "−x²",
        "1/x²",
        "−2x"
      ],
      "answer": 0,
      "why": "A negative exponent means reciprocal, so 1/x^(−2) = x²."
    }
  ],
  "keys": [
    "x^(m/n) = (ⁿ√x)^m: root first, then power.",
    "Power of a power: multiply exponents. Same base multiplied: add them.",
    "Factor rational expressions, then cancel common factors."
  ],
  "recall": [
    {
      "type": "predict",
      "prompt": "27^(1/3) =",
      "choices": [
        "3",
        "9",
        "1/3"
      ],
      "answer": 0,
      "why": "3³ = 27."
    },
    {
      "type": "predict",
      "prompt": "x^(3/4) equals:",
      "choices": [
        "⁴√(x³)",
        "³√(x⁴)",
        "3x/4"
      ],
      "answer": 0,
      "why": "The denominator is the root."
    },
    {
      "type": "fill",
      "prompt": "Simplify √72.",
      "lines": [
        "√72 = √(36 × 2)",
        "= ___√2"
      ],
      "accept": [
        "6"
      ],
      "why": "√36 = 6."
    }
  ],
  "format": "classic"
}
