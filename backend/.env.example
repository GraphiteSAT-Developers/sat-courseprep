# Copy to backend/.env for local development. Never commit the real .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Leave unset to use a local SQLite file at backend/instance/graphite.db
# DATABASE_URL=postgresql://user:password@host:5432/graphite
BASE_URL=http://127.0.0.1:8000
# Email. Without SMTP_HOST, emails are printed to the server log instead of sent.
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Graphite SAT <hello@graphiteprep.com>
# ADMIN_EMAIL=you@example.com
# Payments. Without STRIPE_SECRET_KEY, checkout starts plans without charging anyone.
# Start with test keys (sk_test_...). The webhook secret (whsec_...) comes from the webhook you add in Stripe.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# The AI tutor. Without either setting the tutor page says "Coming soon". See backend/README.md, "Connect the tutor".
# Qwen in the cloud (Alibaba Cloud Model Studio): just the key.
# QWEN_API_KEY=sk-...
# Or your own Qwen server (Ollama, vLLM, anything OpenAI-compatible):
# QWEN_BASE_URL=http://localhost:11434/v1
# QWEN_MODEL=qwen3:8b

# Encrypts profile photos, parent emails and home page messages. Make one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe: if it's lost, that data can't be read. (On your computer it can be left out.)
# DATA_KEY=

# Optional bot check on sign-up, password resets and the home page form: Cloudflare Turnstile (free).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
